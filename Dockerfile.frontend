FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Build args jadi env vars saat build time
ARG INFERENCE_BASE_URL=http://transformerlab:8339/v1
ARG OLLAMA_BASE_URL=http://ollama:11434
ARG HOST_RUNNER=docker
ARG DOCKER_CONTAINER=transformerlab
ENV INFERENCE_BASE_URL=$INFERENCE_BASE_URL
ENV OLLAMA_BASE_URL=$OLLAMA_BASE_URL
ENV HOST_RUNNER=$HOST_RUNNER
ENV DOCKER_CONTAINER=$DOCKER_CONTAINER
ENV DOCKER_BUILD=1
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
# The server-side stores (deployments, settings, job logs, inference log) default to
# `$(cwd)/.rantai-data`, i.e. /app/.rantai-data — which appuser cannot create because
# /app is root-owned. Point them at a dedicated dir owned by appuser and expose it as
# a volume, otherwise every write fails (EACCES) and the data is lost on restart.
ENV RANTAI_DATA_DIR=/data
RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
 && mkdir -p /data && chown appuser:appgroup /data
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
# pdfjs-dist loads @napi-rs/canvas at runtime (DOMMatrix/Path2D polyfill) via a
# dynamic require the standalone tracer can't follow, so it's copied in explicitly
# — including its platform binary (…-linux-x64-musl). Without it PDF extraction
# throws "DOMMatrix is not defined" and every corpus process fails.
COPY --from=builder /app/node_modules/@napi-rs ./node_modules/@napi-rs
# pdfjs also loads its worker (pdf.worker.mjs) dynamically at run time, which the
# tracer misses — copy the whole package so the worker + build assets are present.
COPY --from=builder /app/node_modules/pdfjs-dist ./node_modules/pdfjs-dist
USER appuser
VOLUME ["/data"]
EXPOSE 3000
CMD ["node", "server.js"]
